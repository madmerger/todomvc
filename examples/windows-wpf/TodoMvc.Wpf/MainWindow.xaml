<Window x:Class="TodoMvc.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:TodoMvc.Core;assembly=TodoMvc.Core"
        xmlns:local="clr-namespace:TodoMvc.Wpf"
        FocusManager.FocusedElement="{Binding ElementName=NewTodoBox}"
        Title="TodoMVC - WPF"
        Width="600"
        Height="620"
        Background="#F5F5F5"
        FontFamily="Segoe UI"
        FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="480" Margin="0,20,0,20">
            <TextBlock Text="todos"
                       FontSize="72"
                       FontWeight="Thin"
                       Foreground="{StaticResource TitleBrush}"
                       HorizontalAlignment="Center" />

            <Border Background="White" BorderBrush="#E6E6E6" BorderThickness="1" Margin="0,10,0,0">
                <StackPanel>
                    <!-- New todo -->
                    <Grid>
                        <TextBox x:Name="NewTodoBox"
                                 Text="{Binding NewTodoTitle, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="20"
                                 Padding="16,12"
                                 BorderThickness="0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="What needs to be done?"
                                   FontSize="20"
                                   FontStyle="Italic"
                                   Foreground="#C9C9C9"
                                   Margin="19,12"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NewTodoTitle}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Main -->
                    <StackPanel Visibility="{Binding Store.ShowMainAndFooter, Converter={StaticResource BoolToVisibility}}">
                        <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ToggleAllCheckBox"
                                          Margin="16,0,8,0"
                                          VerticalAlignment="Center"
                                          ToolTip="Mark all as complete"
                                          IsChecked="{Binding Store.AllCompleted}" />
                                <TextBlock Text="Mark all as complete"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,10" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding VisibleTodos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0">
                                        <Grid Margin="16,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"
                                                      IsChecked="{Binding Completed}"
                                                      Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       FontSize="18"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}">
                                                <TextBlock.InputBindings>
                                                    <MouseBinding Gesture="LeftDoubleClick"
                                                                  Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}" />
                                                </TextBlock.InputBindings>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Completed}" Value="True">
                                                                <Setter Property="Foreground" Value="#D9D9D9" />
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Button Grid.Column="2"
                                                    Content="×"
                                                    FontSize="22"
                                                    Foreground="#CC9A9A"
                                                    Style="{StaticResource LinkButton}"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}" />

                                            <TextBox Grid.Column="0"
                                                     Grid.ColumnSpan="3"
                                                     FontSize="18"
                                                     Padding="4"
                                                     Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                                                     local:FocusBehavior.FocusOnVisible="True"
                                                     LostFocus="OnEditBoxLostFocus">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter"
                                                                Command="{Binding DataContext.CommitEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                    <KeyBinding Key="Escape"
                                                                Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Footer -->
                    <Border BorderBrush="{StaticResource SeparatorBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,10"
                            Visibility="{Binding Store.ShowMainAndFooter, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}">
                                <Run Text="{Binding Store.CounterText, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text=" left" />
                            </TextBlock>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <ToggleButton Content="All"
                                              Style="{StaticResource FilterLink}"
                                              IsChecked="{Binding IsAllFilter, Mode=OneWay}"
                                              Command="{Binding SetFilterCommand}"
                                              CommandParameter="{x:Static core:TodoFilter.All}" />
                                <ToggleButton Content="Active"
                                              Style="{StaticResource FilterLink}"
                                              IsChecked="{Binding IsActiveFilter, Mode=OneWay}"
                                              Command="{Binding SetFilterCommand}"
                                              CommandParameter="{x:Static core:TodoFilter.Active}" />
                                <ToggleButton Content="Completed"
                                              Style="{StaticResource FilterLink}"
                                              IsChecked="{Binding IsCompletedFilter, Mode=OneWay}"
                                              Command="{Binding SetFilterCommand}"
                                              CommandParameter="{x:Static core:TodoFilter.Completed}" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="Clear completed"
                                    Style="{StaticResource LinkButton}"
                                    VerticalAlignment="Center"
                                    Command="{Binding ClearCompletedCommand}"
                                    Visibility="{Binding Store.ShowClearCompleted, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="Double-click a todo to edit it"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"
                       Foreground="#BFBFBF" />
        </StackPanel>
    </ScrollViewer>
</Window>
